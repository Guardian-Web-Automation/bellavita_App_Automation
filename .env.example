# Copy to .env and fill in. .env is git-ignored.

# --- Device / build ---
ANDROID_DEVICE_UDID=emulator-5554
ANDROID_APP_PACKAGE=com.bellavita.shopifyapps
ANDROID_APP_ACTIVITY=com.bellavita.shopifyapps.MainActivity
# Optional: absolute path to the .apk if you want WDIO to (re)install it each run.
# Leave blank to drive the already-installed app.
ANDROID_APP_PATH=

# --- Appium server ---
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# --- Gmail OTP utility (port from the web framework) ---
GMAIL_OTP_USER=
GMAIL_OTP_CLIENT_ID=
GMAIL_OTP_CLIENT_SECRET=
GMAIL_OTP_REFRESH_TOKEN=

# --- Slack notifications (port from the web framework) ---
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#qa-automation

# --- Test account / API setup (staging) ---
TEST_USER_EMAIL=
STAGING_API_BASE_URL=
STAGING_API_TOKEN=
