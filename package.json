{
  "name": "bellavita-app-automation",
  "version": "0.1.0",
  "description": "Appium + WebdriverIO + TypeScript regression framework for the Bellavita React Native app (Android now, iOS later)",
  "type": "module",
  "scripts": {
    "android": "wdio run ./config/wdio.android.conf.ts",
    "ios": "wdio run ./config/wdio.ios.conf.ts",
    "report:generate": "allure generate ./reports/allure-results --clean -o ./reports/allure-report",
    "report:open": "allure open ./reports/allure-report",
    "report": "npm run report:generate && npm run report:open",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "typescript",
    "bellavita",
    "mobile",
    "qa"
  ],
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@wdio/allure-reporter": "^9.0.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/globals": "^9.0.0",
    "@wdio/junit-reporter": "^9.32.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "allure-commandline": "^2.30.0",
    "appium": "^3.0.0",
    "appium-uiautomator2-driver": "^8.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "winston": "^3.14.0"
  }
}
